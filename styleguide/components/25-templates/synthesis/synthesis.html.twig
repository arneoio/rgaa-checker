<div class="t-synthesis">
    <header class="o-header" role="banner">
        <div class="o-header__left">
            {% include '@atom/icon/icon.html.twig' with {
              name: 'arneo-logo',
              attributeList: {
                class: 'o-header__logo'
              }
            } only %}
            <h1 href="https://github.com/arneoio/rgaa-checker/blob/main/README.md" class="o-header__externalLink">
                RGAA Checker - Synthèse
            </h1>
            <span class="o-header__version">v{{ version }}</span>
        </div>
        <div class="o-header__right">
            <a class="o-header__button" title="Retour aux tests de la page" href="/rgaa-checker-panel.html">
                {% include '@atom/icon/icon.html.twig' with {
                  name: 'arrow-left',
                  attributeList: {
                    class: 'o-header__buttonIcon'
                  }
                } only %}
            </a>
            {# <button class="o-header__settingsButton" title="Paramètres">
                {% include '@atom/icon/icon.html.twig' with {
                  name: 'settings',
                  attributeList: {
                    class: 'o-header__buttonIcon'
                  }
                } only %}
            </button> #}
        </div>
    </header>
    <main role="main" class="t-synthesis__main">
        <h2 class="t-synthesis__title">Synthèse pour le domaine <span class="js-synthesis__hostname"></span></h2>
        <h3 class="t-synthesis__subtitle">Progression de l'audit</h3>
        <progress class="t-synthesis__progress js-synthesis__progress" value="0" max="100"></progress>
        <p class="js-synthesis__progressValue"></p>

        <h3 class="t-synthesis__subtitle">URL testées</h3>
        <ul class="t-synthesis__list js-synthesis__urlList"></ul>

        <template id="js-synthesis__urlItem__template">
            <li>
                <span class="js-synthesis__urlItem__slug"></span> -
                <a class="js-synthesis__urlItem__link"></a>
                <button class="js-synthesis__urlItem__removeButton t-synthesis__list__button">
                  {% include '@atom/icon/icon.html.twig' with {
                    name: 'cross',
                    attributeList: {
                      class: 't-synthesis__list__icon'
                    }
                  } only %}
                </button>
            </li>
        </template>
        <h3 class="t-synthesis__subtitle">Synthèse par page</h3>
        <table class="t-synthesis__table">
            <thead>
                <tr>
                    <th>Page</th>
                    <th><acronym title="Conforme" class="t-synthesis__status -status-c">C</acronym></th>
                    <th><acronym title="Non conforme" class="t-synthesis__status -status-nc">NC</acronym></th>
                    <th><acronym title="Non applicable" class="t-synthesis__status -status-na">NA</acronym></th>
                    <th><acronym title="Non traité" class="t-synthesis__status -status-nt">NT</acronym></th>
                </tr>
            </thead>
            <tbody class="js-synthesis__tableBody">
            </tbody>
        </table>
        {# Template for table row #}
        <template id="js-synthesis__rowTemplate">
            <tr>
                <td class="js-synthesis__row__pageName"></td>
                <td class="js-synthesis__row__c"></td>
                <td class="js-synthesis__row__nc"></td>
                <td class="js-synthesis__row__na"></td>
                <td class="js-synthesis__row__nt"></td>
            </tr>
        </template>

        <h3 class="t-synthesis__subtitle">Synthèse par thématique</h3>

        <table class="t-synthesis__table">
            <thead>
                <tr>
                    <th>Thématique</th>
                    <th><acronym title="Conforme" class="t-synthesis__status -status-c">C</acronym></th>
                    <th><acronym title="Non conforme" class="t-synthesis__status -status-nc">NC</acronym></th>
                    <th><acronym title="Non applicable" class="t-synthesis__status -status-na">NA</acronym></th>
                </tr>
            </thead>
            <tbody>
{% for topic in topicList %}
                <tr>
                    <td>{{ topic.number }}. {{ topic.topic }}</td>
                    <td class="js-synthesis__thematicCell" data-topic="{{ topic.number }}" data-status="c">0</td>
                    <td class="js-synthesis__thematicCell" data-topic="{{ topic.number }}" data-status="nc">0</td>
                    <td class="js-synthesis__thematicCell" data-topic="{{ topic.number }}" data-status="na">0</td>
                </tr>
{% endfor %}
            </tbody>
        </table>

        <h2 class="t-synthesis__subtitle">Déclaration d'accessibilité</h2>

        <h3 class="t-synthesis__subtitle">Critères non accessibles</h3>

        <ul class="t-synthesis__list js-synthesis__criteriaList">
{% for topic in topicList %}
    {% for criteria in topic.criteria %}
            <li class="t-synthesis__criteriaList__item js-synthesis__criteriaList__item" data-criterium="{{ topic.number ~ '.' ~ criteria.criterium.number }}">
                {{ topic.number ~ '.' ~ criteria.criterium.number }} - {{ criteria.criterium.title | striptags }}
            </li>
    {% endfor %}
{% endfor %}
        </ul>
    </main>
</div>
